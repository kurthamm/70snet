+/*
+ *	70snet: modem control port 0FFH.
+ *
+ *	CBBS 3.5's outboard-modem driver (cbbsmodm.asm) reads carrier and ring
+ *	from this port and writes off-hook to it. The bits are ACTIVE LOW:
+ *
+ *	    input  40H = NOT carrier detect	(clear = carrier present)
+ *	    input  20H = NOT ring indicator	(clear = ringing)
+ *	    output 10H = off hook
+ *
+ *	Spike stage: carrier is hardwired present so CBBS proceeds to look for
+ *	a CR. Task 6 drives this from the supervisor over a FIFO.
+ */
+#define PHONE_CARRIER	0x40
+#define PHONE_RING	0x20
+
+static BYTE phone_status = (BYTE) (0xff & ~PHONE_CARRIER);
+
+static BYTE phone_in(void)
+{
+	return phone_status;
+}
+
+static void phone_out(BYTE data)
+{
+	UNUSED(data);
+}
