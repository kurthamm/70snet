+/* Open a FIFO O_RDWR so the open never blocks waiting for a peer, and so a
+   supervisor closing its end does not deliver EOF forever after. */
+static int line_fifo(const char *dir, const char *name)
+{
+	char path[512];
+	struct stat sb;
+	int fd;
+
+	snprintf(path, sizeof(path), "%s/%s", dir, name);
+	if (stat(path, &sb) != 0)
+		if (mkfifo(path, 0666) != 0) {
+			LOGE(TAG, "can't create telephone line fifo");
+			exit(EXIT_FAILURE);
+		}
+	if ((fd = open(path, O_RDWR | O_NONBLOCK)) == -1) {
+		LOGE(TAG, "can't open telephone line fifo");
+		exit(EXIT_FAILURE);
+	}
+	return fd;
+}
+
+static void init_telephone_line(void)
+{
+	const char *dir = getenv("SEVENTIESNET_LINE");
+
+	if (dir == NULL)
+		return;			/* ordinary terminal console */
+
+	line_in_fd = line_fifo(dir, "line.in");
+	line_out_fd = line_fifo(dir, "line.out");
+	phone_in_fd = line_fifo(dir, "phone.in");
+	phone_out_fd = line_fifo(dir, "phone.out");
+}
