+/*
+ *	70snet: the telephone line.
+ *
+ *	CBBS does its terminal I/O through the CP/M BIOS console vectors --
+ *	TYPE in cbbssub2.asm calls an address patched in by INIT -- and on
+ *	Randy Suess's machine that console WAS the modem. So when the
+ *	environment names SEVENTIESNET_LINE, ports 0 and 1 stop being a
+ *	terminal and become the phone line: a FIFO pair the supervisor drives.
+ *
+ *	Nothing is filtered in either direction. A modem line is 8-bit clean,
+ *	unlike cpmsim's auxiliary device, which drops CR and ^Z.
+ *
+ *	Port 0FFH is the modem control port cbbsmodm.asm expects. Its bits are
+ *	ACTIVE LOW:
+ *	    in  40H = NOT carrier detect   (clear = carrier present)
+ *	    in  20H = NOT ring indicator   (clear = ringing)
+ *	    out 10H = off hook
+ *	Idle is 0xFF: no carrier, not ringing. An unimplemented port would read
+ *	the same, so a supervisor that never speaks leaves CBBS waiting rather
+ *	than falsely connected.
+ */
+/*
+ *	70snet: Scitronics clock board at ports 24-27 (cbbsclks.asm).
+ *
+ *	This is how the timeline in spec §5.3 becomes real without touching
+ *	CBBS: the board reports the ROOM's date, and CBBS stamps its own
+ *	messages with it via RDDATE. A 1980 visitor's post is dated 1980
+ *	because the hardware said so, exactly as it worked in Chicago.
+ *
+ *	Protocol, read out of the 1981 source:
+ *	  CLKINIT does IN 24 and treats 0FFH as "no clock", then writes a PIA
+ *	  init sequence which we ignore.
+ *	  CLKDIG writes a digit index to port 24, reads port 24 back, and takes
+ *	  the HIGH NIBBLE as the BCD digit.
+ *	  RDDATE walks indices 10,9 then 8,7 then 12,11 to build "MM/DD/YY".
+ *
+ *	Index map (higher index is the tens digit of each pair), confirmed by
+ *	running CBBS's own T command against it rather than by guessing:
+ *	  12,11 year   10,9 month   8,7 day   5,4 hour   3,2 min   1,0 sec
+ *	Index 6 is unused. Index 5 is the hours TENS, which is why CLKDIG masks
+ *	that one with 70H -- it only ever holds 0-2.
+ *
+ *	The date comes from SEVENTIESNET_DATE. There is no fallback to the
+ *	host clock: a silently wrong date would put messages in the wrong era,
+ *	and spec §3 calls that unrecoverable.
+ */
+#define CLOCK_HOUR	20	/* evening -- when you actually called a board */
+#define CLOCK_MINUTE	15
+
+static BYTE clock_digits[13];		/* indices 0-12 */
+static BYTE clock_select = 0;
+static int clock_ready = 0;
+
+static void init_clock(void)
+{
+	const char *d = getenv("SEVENTIESNET_DATE");
+	int mm, dd, yy;
+
+	if (d == NULL) {
+		LOGE(TAG, "SEVENTIESNET_DATE is not set; refusing to invent a date");
+		exit(EXIT_FAILURE);
+	}
+	if (strlen(d) != 10 || d[4] != '-' || d[7] != '-') {
+		LOGE(TAG, "SEVENTIESNET_DATE must be YYYY-MM-DD");
+		exit(EXIT_FAILURE);
+	}
+
+	yy = (d[2] - '0') * 10 + (d[3] - '0');
+	mm = (d[5] - '0') * 10 + (d[6] - '0');
+	dd = (d[8] - '0') * 10 + (d[9] - '0');
+
+	clock_digits[12] = yy / 10;  clock_digits[11] = yy % 10;
+	clock_digits[10] = mm / 10;  clock_digits[9]  = mm % 10;
+	clock_digits[8]  = dd / 10;  clock_digits[7]  = dd % 10;
+	clock_digits[6]  = 0;			/* unused by CBBS */
+	clock_digits[5]  = CLOCK_HOUR / 10;   clock_digits[4] = CLOCK_HOUR % 10;
+	clock_digits[3]  = CLOCK_MINUTE / 10; clock_digits[2] = CLOCK_MINUTE % 10;
+	clock_digits[1]  = 0; clock_digits[0] = 0;
+	clock_ready = 1;
+}
+
+static BYTE clock_in(void)
+{
+	if (!clock_ready)
+		init_clock();
+	/* CLKINIT probes before selecting anything; anything but 0FFH means
+	   "a clock is present". */
+	if (clock_select > 12)
+		return 0x00;
+	return (BYTE) (clock_digits[clock_select] << 4);
+}
+
+static void clock_out(BYTE data)
+{
+	/* CLKDIG writes the digit index it wants; CLKINIT and CLKCONT write
+	   PIA setup bytes, which are all outside 1..12 and select nothing. */
+	clock_select = data;
+}
+
+static BYTE phone_in(void)
+{
+	BYTE b;
+
+	/* Take the most recent line state the supervisor has written. */
+	while (phone_in_fd >= 0 && read(phone_in_fd, &b, 1) == 1)
+		phone_status = b;
+	return phone_status;
+}
+
+static void phone_out(BYTE data)
+{
+	if (phone_out_fd >= 0)
+		if (write(phone_out_fd, &data, 1) != 1)
+			LOGE(TAG, "can't report off-hook to the supervisor");
+}
